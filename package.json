{
  "name": "briefforge-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root runner for BriefForge services",
  "scripts": {
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "ai-service": "cd ai-service && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev": "npx concurrently --kill-others -n \"backend,ai-service,frontend\" -c \"blue,green,magenta\" \"npm run backend\" \"npm run ai-service\" \"npm run frontend\""
  }
}
